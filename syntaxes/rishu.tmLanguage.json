{
  "scopeName": "source.rishu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rishu",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rishu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rishu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rishu",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.declaration.rishu",
          "match": "\\b(let)\\b"
        },
        {
          "name": "support.function.rishu",
          "match": "\\b(say)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rishu",
          "match": "\\b(?:0|[1-9][0-9]*)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.rishu",
          "match": ">=|<=|==|!=|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.rishu",
          "match": "[+\\-*/=]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rishu",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rishu",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  }
}